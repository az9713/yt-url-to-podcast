{
  "name": "yt-to-podcast",
  "private": true,
  "type": "module",
  "description": "Turns a YouTube video into an HTML summary and a single-host episode. Start from a URL or a screenshot. Optional Pi extension included.",
  "keywords": ["pi-package"],
  "pi": {
    "extensions": ["./extensions/index.ts"],
    "skills": ["./skills"]
  },
  "scripts": {
    "test": "node --experimental-strip-types --test test/pipeline.test.ts test/ledger.test.ts test/identify.test.ts",
    "app": "node --experimental-strip-types src/web.ts",
    "start": "pi --no-session --no-tools -e ./extensions/index.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  }
}
